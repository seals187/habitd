# Copy to .env and adjust. .env is ignored by git.

# Port the app listens on, inside the container and on the host.
HABITD_PORT=8080

# Login name. Applied on every start.
HABITD_USER=admin

# Password. Only used on the very first start, change it later under Profil > Server.
HABITD_PASSWORD=choose-a-long-password

# false for plain HTTP, true behind HTTPS.
HABITD_COOKIE_SECURE=false

# Optional bearer token for /api/v1.
HABITD_API_TOKEN=
