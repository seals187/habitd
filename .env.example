# Copy to .env and adjust. .env is ignored by git.

# Port the app listens on, inside the container and on the host.
HABITD_PORT=8080

# First admin. Only used on the very first start, later changes have no effect.
# Leave the password empty to create the first account on the setup page instead.
HABITD_ADMIN_USER=admin
HABITD_ADMIN_PASSWORD=

# Anyone who can reach habitd may create an account.
HABITD_ALLOW_SIGNUP=false

# Plain HTTP for local use. Keep it false behind HTTPS.
HABITD_INSECURE_COOKIES=true

# Optional bearer token for /api/v1. It acts as the first active admin.
HABITD_API_TOKEN=

# Deprecated, same as HABITD_ADMIN_PASSWORD with the user admin.
# HABITD_PASSWORD=
